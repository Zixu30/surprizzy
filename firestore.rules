rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public product catalog can be read by shoppers.
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == "8369860594@surprizzy-admin.local";
    }

    // Orders are created/read/updated only by the authenticated admin
    // in this starter setup. For a public checkout, add a server-side
    // order endpoint or a tightly scoped customer auth flow.
    match /orders/{orderId} {
      allow read, create, update: if request.auth != null
                   && request.auth.token.email == "8369860594@surprizzy-admin.local";
      allow delete: if request.auth != null
                   && request.auth.token.email == "8369860594@surprizzy-admin.local";
    }
  }
}